#include <stdio.h>
#include <stdlib.h>

struct Node
{
    int data;
    struct Node *next;
};

// Create linked list
struct Node* createList()
{
    struct Node *head = NULL;
    struct Node *newNode, *temp;
    int n, i, value;

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    for (i = 1; i <= n; i++)
    {
        newNode = (struct Node*)malloc(sizeof(struct Node));

        printf("Enter data for node %d: ", i);
        scanf("%d", &value);

        newNode->data = value;
        newNode->next = NULL;

        if (head == NULL)
        {
            head = newNode;
            temp = head;
        }
        else
        {
            temp->next = newNode;
            temp=temp->next;
        }
    }

    return head;
}

// Display linked list
void display(struct Node *head)
{
    struct Node *temp = head;

    if (head == NULL)
    {
        printf("Linked List is empty.\n");
        return;
    }

    printf("Linked List: ");

    while (temp != NULL)
    {
        printf("%d -> ", temp->data);
        temp = temp->next;
    }

    printf("NULL\n");
}

// Delete first node
struct Node* deleteFirst(struct Node *head)
{
    struct Node *temp;

    if (head == NULL)
    {
        printf("Linked List is empty.\n");
        return head;
    }

    temp = head;
    head = head->next;

    free(temp);

    printf("First node deleted successfully.\n");

    return head;
}

// Delete last node
struct Node* deleteLast(struct Node *head)
{
    struct Node *temp;

    if (head == NULL)
    {
        printf("Linked List is empty.\n");
        return head;
    }

    // Only one node
    if (head->next == NULL)
    {
        free(head);
        head = NULL;

        printf("Last node deleted successfully.\n");

        return head;
    }

    temp = head;

    // Move to second-last node
    while (temp->next->next != NULL)
    {
        temp = temp->next;    }

    free(temp->next);
    temp->next = NULL;

    printf("Last node deleted successfully.\n");

    return head;
}

// Delete node at a given position
struct Node* deleteAtPosition(struct Node *head)
{
    struct Node *temp;
    struct Node *deleteNode;

    int position;
    int i;

    printf("Enter position to delete: ");
    scanf("%d", &position);

    if (head == NULL)
    {        printf("Linked List is empty.\n");
        return head;
    }

    if (position <= 0)
    {
        printf("Invalid position.\n");
        return head;
    }

    // Delete first node
        if (position == 1)
    {
        temp = head;
        head = head->next;

        free(temp);

        printf("Node at position 1 deleted successfully.\n");

        return head;
    }

    temp = head;

    // Move to node before the position
    for (i = 1; i < position - 1 && temp != NULL; i++)
    {
        temp = temp->next;
    }

    // Position does not exist
    if (temp == NULL || temp->next == NULL)
    {
        printf("Invalid position.\n");
        return head;
    }

    deleteNode = temp->next;

    temp->next = deleteNode->next;
    free(deleteNode);

    printf("Node at position %d deleted successfully.\n", position);

    return head;
}

// Main function
int main()
{
    struct Node *head;
    int choice;

    head = createList();

    while (1)
    {
        printf("\n========== MENU ==========\n");
        printf("1. Display\n");
       printf("2. Delete First Node\n");
        printf("3. Delete Last Node\n");
        printf("4. Delete Node at Position\n");
        printf("5. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                display(head);
                break;

            case 2:
                head = deleteFirst(head);
                break;

            case 3:
                head = deleteLast(head);
                break;

            case 4:
                head = deleteAtPosition(head);
               break;

            case 5:
                printf("Program terminated.\n");
                return 0;

            default:
                printf("Invalid choice.\n");
        }
    }
}
